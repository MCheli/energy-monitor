# Copy to .env and edit. The defaults work for local development.

# Encryption key for sensitive runtime settings (HA tokens). Generate with:
#   openssl rand -base64 32
# Required in production. Rotating this invalidates any encrypted values
# already in the database.
SECRET_KEY=

# Where the app reads/writes state. Inside the container this defaults to /data
# (and /data is bind-mounted to a Docker volume). On host installs, point this
# at any writable directory.
# PANEL_TOOL_DATA_DIR=/data

# Listen port (inside the container). Compose maps host port 8000 → 8000.
# PANEL_TOOL_PORT=8000

# Database URL. Defaults to a SQLite file under PANEL_TOOL_DATA_DIR.
# For Postgres:  postgresql://panel_tool:<password>@panel-tool-db:5432/panel_tool
# DATABASE_URL=

# Optional HTTP basic-auth gate ("user:password"). The homelab pattern
# terminates auth at nginx, so this is empty by default. Turn it on if you
# expose the app more broadly than your trusted LAN.
# PANEL_TOOL_BASIC_AUTH=
